# Official API name for DeepSeek-V4.1-Flash. All LLM agents use this one model.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_REQUEST_TIMEOUT_SECONDS=300

# Optional absolute paths; defaults are models/ and runtime/ beside this file.
# SWMM_MODELS_DIR=E:/my_models
# SWMM_RUNTIME_DIR=E:/my_runtime
